  },
  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./packages/docusaurus-preset-nova": {
        "prefix": "PRESET_"
      },
      "./packages/nova": {
        "prefix": "NOVA_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "semver"
  }
}
