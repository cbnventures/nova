{
  "name": "[__WORKSPACE_PACKAGE_NAME__]",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development 'dev:*'",
    "dev:project": "xcodegen generate",
    "check": "nova utility run-scripts --sequential 'check:*'",
    "check:project": "xcodegen generate",
    "check:test": "xcodebuild test -scheme [__WORKSPACE_IDENTIFIER__] -destination 'platform=macOS' -derivedDataPath ./build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "build": "nova utility run-scripts --sequential --node-env production 'build:*'",
    "build:project": "xcodegen generate",
    "build:app": "xcodebuild build -scheme [__WORKSPACE_IDENTIFIER__] -destination 'generic/platform=macOS' -derivedDataPath ./build/DerivedData CODE_SIGNING_ALLOWED=NO",
    "clean": "nova utility run-scripts --parallel 'clean:*'",
    "clean:project": "shx rm -rf ./[__WORKSPACE_IDENTIFIER__].xcodeproj ./build"
  },
  "dependencies": {
    "@cbnventures/nova": "0.29.0"
  },
  "devDependencies": {
    "shx": "0.4.0"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
