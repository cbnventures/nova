{
  "project": {
    "name": {
      "title": "Nova",
      "slug": "nova"
    },
    "description": {
      "short": "Strict presets, guided tooling, and project scaffolds for JavaScript and TypeScript developers",
      "long": "Strict presets, guided generators, and recipes that keep JavaScript and TypeScript monorepos consistent from the first scaffold to the hundredth release. Linting, typing, workflows, and project metadata all flow from one config, so nothing quietly drifts."
    },
    "keywords": [
      "eslint",
      "eslint-config",
      "eslint-flat-config",
      "typescript",
      "tsconfig",
      "tsconfig-presets",
      "linting",
      "code-style",
      "scripts",
      "templates",
      "docusaurus-preset",
      "react",
      "nextjs",
      "node",
      "monorepo"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2025,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "nova",
    "topics": [
      "eslint-config",
      "eslint",
      "typescript",
      "tsconfig",
      "eslint-flat-config",
      "monorepo",
      "linting",
      "developer-tools"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "nodejs",
        "docs-site",
        "web",
        "screenshots"
      ],
      "customQuestions": {
        "bug": [
          {
            "type": "dropdown",
            "id": "nova-area",
            "attributes": {
              "label": "Nova Area",
              "description": "Select the Nova area involved.",
              "options": [
                "CLI Generator",
                "CLI Recipe",
                "CLI Utility",
                "CLI Integration",
                "Scaffold",
                "ESLint Preset or Rule",
                "Vitest Rule",
                "TSConfig Preset",
                "Toolkit Battery",
                "Docusaurus Preset",
                "Documentation",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "workspace-role",
            "attributes": {
              "label": "Workspace Role",
              "description": "Select the affected workspace role when applicable.",
              "options": [
                "Project",
                "Docs",
                "Config",
                "App",
                "Package",
                "Tool",
                "Template",
                "Not Applicable"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "feature": [
          {
            "type": "dropdown",
            "id": "nova-area",
            "attributes": {
              "label": "Nova Area",
              "description": "Select the Nova area involved.",
              "options": [
                "CLI Generator",
                "CLI Recipe",
                "CLI Utility",
                "CLI Integration",
                "Scaffold",
                "ESLint Preset or Rule",
                "Vitest Rule",
                "TSConfig Preset",
                "Toolkit Battery",
                "Docusaurus Preset",
                "Documentation",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          },
          {
            "type": "dropdown",
            "id": "workspace-role",
            "attributes": {
              "label": "Workspace Role",
              "description": "Select the affected workspace role when applicable.",
              "options": [
                "Project",
                "Docs",
                "Config",
                "App",
                "Package",
                "Tool",
                "Template",
                "Not Applicable"
              ]
            },
            "validations": {
              "required": false
            }
          }
        ],
        "support": [
          {
            "type": "dropdown",
            "id": "nova-area",
            "attributes": {
              "label": "Nova Area",
              "description": "Select the Nova area involved.",
              "options": [
                "CLI Generator",
                "CLI Recipe",
                "CLI Utility",
                "CLI Integration",
                "Scaffold",
                "ESLint Preset or Rule",
                "Vitest Rule",
                "TSConfig Preset",
                "Toolkit Battery",
                "Docusaurus Preset",
                "Documentation",
                "Other"
              ]
            },
            "validations": {
              "required": true
            }
          }
        ]
      }
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "tag-push"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./packages/nova",
        "./packages/docusaurus-preset-nova",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "npm",
          "path": "./packages/nova"
        },
        {
          "to": "npm",
          "path": "./packages/docusaurus-preset-nova",
          "after": [
            "./packages/nova"
          ]
        },
        {
          "to": "github-packages",
          "path": "./packages/nova"
        },
        {
          "to": "github-packages",
          "path": "./packages/docusaurus-preset-nova",
          "after": [
            "./packages/nova"
          ]
        },
        {
          "to": "cloudflare-pages",
          "path": "./apps/docs"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://nova.cbnventures.io/",
    "repository": "git+https://github.com/cbnventures/nova.git",
    "bugs": "https://github.com/cbnventures/nova/issues",
    "license": "https://github.com/cbnventures/nova/blob/HEAD/LICENSE",
    "logo": "https://nova.cbnventures.io/images/logo.svg",
    "documentation": "https://nova.cbnventures.io/",
    "npm": "https://www.npmjs.com/package/@cbnventures/nova",
    "fundSources": [
      "https://github.com/sponsors/cbnventures",
      "https://www.paypal.com/biz/profile/cbnventures"
    ],
    "privacyPolicy": "https://www.cbnventures.io/privacy/",
    "termsOfUse": "https://www.cbnventures.io/terms/"
  },
  "readme": {
    "badges": [
      "npm-version",
      "npm-downloads",
      "github-release",
      "github-top-language",
      "github-license",
      "funding"
    ]
  },
  "workspaces": {
    "./": {
      "name": "nova-project",
      "role": "project",
      "policy": "freezable"
    },
    "./apps/docs": {
      "name": "nova-docs",
      "role": "docs",
      "policy": "freezable"
    },
    "./packages/docusaurus-preset-nova": {
      "name": "@cbnventures/docusaurus-preset-nova",
      "role": "package",
      "policy": "distributable"
    },
    "./packages/nova": {
      "name": "@cbnventures/nova",
      "role": "package",
      "policy": "distributable"
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "/assets/",
        "!packages/nova/bin/",
        "!packages/docusaurus-preset-nova/bin/",
        "graphify-out/"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
        "enabled": true
      },
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": true,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": true,
            "desktopServicesStore": true
          },
          "windows": {
            "enhancedThumbnailDatabase": true,
            "enhancedVistaThumbnailDatabase": true,
            "thumbnailDatabase": true
          }
        }
      }
    },
    "nova-config": {
      "normalize-order": {
        "enabled": true
      }
    },
    "read-me": {
      "update-badges": {
        "enabled": true
      },
      "update-credits": {
        "enabled": true
      },
      "update-documentation": {
        "enabled": true
      },
      "update-header": {
        "enabled": true
      },
      "update-introduction": {
        "enabled": true
      }
    },
    "tsconfig": {
      "sync-references": {
        "enabled": true
      }
    },
    "package-json": {
      "./": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./apps/docs": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./packages/docusaurus-preset-nova": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true,
          "settings": {
            "description": true,
            "keywords": true
          }
        },
        "sync-ownership": {
          "enabled": true,
          "settings": {
            "homepage": true,
            "bugs": true,
            "author": true,
            "contributors": true,
            "funding": true,
            "repository": true
          }
        }
      },
      "./packages/nova": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
