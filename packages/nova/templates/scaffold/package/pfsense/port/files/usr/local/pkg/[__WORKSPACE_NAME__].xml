<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE packagegui SYSTEM "../schema/packages.dtd">
<?xml-stylesheet type="text/xsl" href="../xsl/package.xsl"?>
<packagegui>
	<copyright>
	<![CDATA[
	/*
	 * Generated by Nova for [__PROJECT_SLUG__].
	 * SPDX-License-Identifier: MIT
	 */
	]]>
	</copyright>
	<name>[__WORKSPACE_NAME__]</name>
	<version>%%PKGVERSION%%</version>
	<title>Services: [__WORKSPACE_TITLE__]</title>
	<include_file>/usr/local/pkg/[__WORKSPACE_NAME__].inc</include_file>
	<aftersaveredirect>/pkg.php?xml=[__WORKSPACE_NAME__].xml</aftersaveredirect>
	<menu>
		<name>[__WORKSPACE_TITLE__]</name>
		<section>Services</section>
		<configfile>[__WORKSPACE_NAME__].xml</configfile>
		<url>/pkg.php?xml=[__WORKSPACE_NAME__].xml</url>
	</menu>
	<fields>
		<field>
			<type>listtopic</type>
			<name>[__WORKSPACE_TITLE__] Settings</name>
		</field>
		<field>
			<fielddescr>Enable Scheduled Task</fielddescr>
			<fieldname>enabled</fieldname>
			<type>checkbox</type>
			<description>Run the package's background task on the selected schedule.</description>
		</field>
		<field>
			<fielddescr>Schedule</fielddescr>
			<fieldname>schedule</fieldname>
			<type>select</type>
			<options>
				<option><name>Hourly</name><value>hourly</value></option>
				<option><name>Daily at midnight</name><value>daily</value></option>
				<option><name>Weekly on Sunday</name><value>weekly</value></option>
			</options>
			<description>Choose how often pfSense runs the background task.</description>
		</field>
		<field>
			<fielddescr>Task Message</fielddescr>
			<fieldname>message</fieldname>
			<type>input</type>
			<size>60</size>
			<default_value>Scheduled [__WORKSPACE_TITLE__] task completed.</default_value>
			<description>Starter value written to the pfSense system log by the generated task.</description>
			<required/>
		</field>
	</fields>
	<custom_php_install_command>
		pfsensePackage[__WORKSPACE_IDENTIFIER__]Sync();
	</custom_php_install_command>
	<custom_php_resync_config_command>
		pfsensePackage[__WORKSPACE_IDENTIFIER__]Sync();
	</custom_php_resync_config_command>
	<custom_delete_php_command>
		pfsensePackage[__WORKSPACE_IDENTIFIER__]Remove();
	</custom_delete_php_command>
	<custom_php_validation_command>
		pfsensePackage[__WORKSPACE_IDENTIFIER__]Validate($_POST, $input_errors);
	</custom_php_validation_command>
</packagegui>
