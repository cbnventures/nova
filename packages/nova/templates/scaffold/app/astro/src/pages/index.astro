---
import messages from '../i18n/en.json';
import '../styles/nova-launchpad.css';
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{messages.metadata.title}</title>
  </head>
  <body>
    <main class="nova-launchpad" data-nova-framework="astro">
      <div class="nova-launchpad__shell">
        <header class="nova-launchpad__header">
          <div class="nova-launchpad__brand">
            <svg class="nova-launchpad__mark" aria-hidden="true" viewBox="0 0 1024 1024"><use href="/nova-socials.svg#nova"></use></svg>
            <span>{messages.brand.nova}</span>
            <span class="nova-launchpad__cross">×</span>
            <span>{messages.brand.framework}</span>
          </div>
          <a class="nova-launchpad__docs-link" href="https://nova.cbnventures.io/docs/quickstart/" target="_blank" rel="noreferrer">
            {messages.header.readNovaDocs}
          </a>
        </header>
        <div class="nova-launchpad__body">
          <section>
            <h1 class="nova-launchpad__title">
              <span>{messages.introduction.title}</span>
              <span class="nova-launchpad__title-accent">{messages.introduction.titleAccent}</span>
            </h1>
            <p class="nova-launchpad__lede">
              {messages.introduction.description}
            </p>
            <div class="nova-launchpad__actions">
              <a class="nova-launchpad__primary-link" href="https://docs.astro.build" target="_blank" rel="noreferrer">
                {messages.introduction.exploreDocs}
              </a>
              <span class="nova-launchpad__edit-hint">
                {messages.introduction.editHint} <code>src/pages/index.astro</code>
              </span>
            </div>
          </section>
          <aside class="nova-launchpad__sequence" aria-label={messages.sequence.label}>
            <p class="nova-launchpad__sequence-label">{messages.sequence.label}</p>
            <ol class="nova-launchpad__steps">
              <li class="nova-launchpad__step">
                <span class="nova-launchpad__step-number">{messages.sequence.stepOne.number}</span>
                <div>
                  <strong>{messages.sequence.stepOne.title}</strong>
                  <p>{messages.sequence.stepOne.description}</p>
                </div>
              </li>
              <li class="nova-launchpad__step">
                <span class="nova-launchpad__step-number">{messages.sequence.stepTwo.number}</span>
                <div>
                  <strong>{messages.sequence.stepTwo.title}</strong>
                  <p>{messages.sequence.stepTwo.description}</p>
                </div>
              </li>
              <li class="nova-launchpad__step">
                <span class="nova-launchpad__step-number">{messages.sequence.stepThree.number}</span>
                <div>
                  <strong>{messages.sequence.stepThree.title}</strong>
                  <p>{messages.sequence.stepThree.description}</p>
                </div>
              </li>
            </ol>
          </aside>
        </div>
        <footer class="nova-launchpad__footer">
          <span>{messages.footer.credit}</span>
          <nav class="nova-launchpad__socials" aria-label={messages.footer.socialLabel}>
            <a class="nova-launchpad__social-link" href="https://www.facebook.com/cbnventures" target="_blank" rel="noreferrer" aria-label={messages.footer.facebook}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#facebook"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://x.com/cbnventures" target="_blank" rel="noreferrer" aria-label={messages.footer.x}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#x"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://www.youtube.com/@cbnventures" target="_blank" rel="noreferrer" aria-label={messages.footer.youtube}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#youtube"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://www.instagram.com/cbnventures/" target="_blank" rel="noreferrer" aria-label={messages.footer.instagram}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#instagram"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://github.com/cbnventures" target="_blank" rel="noreferrer" aria-label={messages.footer.github}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#github"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://play.google.com/store/apps/dev?id=6419450160526226105" target="_blank" rel="noreferrer" aria-label={messages.footer.googlePlay}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#google-play"></use></svg>
            </a>
            <a class="nova-launchpad__social-link" href="https://www.linkedin.com/company/cbnventures/" target="_blank" rel="noreferrer" aria-label={messages.footer.linkedin}>
              <svg class="nova-launchpad__social-icon" aria-hidden="true"><use href="/nova-socials.svg#linkedin"></use></svg>
            </a>
          </nav>
        </footer>
      </div>
    </main>
  </body>
</html>
