{
  "name": "nova-project",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/nova-run-workspaces.mjs --node-env development dev",
    "prod": "node ./scripts/nova-run-workspaces.mjs --node-env production prod",
    "check": "node ./scripts/nova-run-workspaces.mjs check",
    "check:lint": "eslint . --max-warnings=0",
    "check:types-config": "node ./scripts/nova-type-check.mjs --project tsconfig.config.json",
    "check:types-scripts": "node ./scripts/nova-type-check.mjs --project tsconfig.scripts.json",
    "check:types-tests": "node ./scripts/nova-type-check.mjs --project tsconfig.tests.json",
    "check:test": "vitest run --exclude \"scripts/tests/**/*.mjs\"",
    "check:cli": "node ./scripts/nova-run-workspaces.mjs build --workspace @cbnventures/nova && vitest run scripts/tests/cli",
    "check:scaffolds": "node ./scripts/check-scaffolds.mjs",
    "build": "node ./scripts/nova-run-workspaces.mjs --node-env production build",
    "deploy": "node ./scripts/nova-run-workspaces.mjs --node-env production deploy",
    "clean": "node ./scripts/nova-run-workspaces.mjs clean",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "scaffold-versions": "node ./scripts/scaffold-versions.mjs",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "allowScripts": {
    "core-js": true,
    "es5-ext": false,
    "fsevents": true,
    "unrs-resolver": true
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@cbnventures/nova": "file:./packages/nova"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.4.3",
    "@types/node": "24.9.1",
    "chalk": "5.6.2",
    "chokidar": "3.6.0",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
