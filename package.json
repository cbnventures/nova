{
  "name": "nova-project",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/nova-run-scripts.mjs --parallel 'dev:*'",
    "dev:workspaces": "turbo run dev",
    "prod": "node ./scripts/nova-run-scripts.mjs --sequential 'prod:*'",
    "prod:workspaces": "turbo run prod",
    "check": "node ./scripts/nova-run-scripts.mjs --sequential 'check:*'",
    "check:workspaces": "turbo run check --concurrency=2",
    "check:lint": "eslint . --max-warnings=0",
    "check:types-config": "node ./scripts/nova-type-check.mjs --project tsconfig.config.json",
    "check:types-scripts": "node ./scripts/nova-type-check.mjs --project tsconfig.scripts.json",
    "check:types-tests": "node ./scripts/nova-type-check.mjs --project tsconfig.tests.json",
    "check:test": "vitest run --exclude \"scripts/tests/**/*.mjs\"",
    "check:cli": "npm run build --workspace=@cbnventures/nova && vitest run scripts/tests/cli",
    "check:scaffolds": "node ./scripts/check-scaffolds.mjs",
    "build": "node ./scripts/nova-run-scripts.mjs --sequential 'build:*'",
    "build:workspaces": "turbo run build --concurrency=2",
    "deploy": "node ./scripts/nova-run-scripts.mjs --sequential 'deploy:*'",
    "deploy:workspaces": "turbo run deploy --concurrency=2",
    "clean": "node ./scripts/nova-run-scripts.mjs --parallel 'clean:*'",
    "clean:workspaces": "turbo run clean",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "allowScripts": {
    "core-js": false,
    "es5-ext": false,
    "unrs-resolver": false
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@cbnventures/nova": "file:./packages/nova"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.4.3",
    "chalk": "5.6.2",
    "chokidar": "3.6.0",
    "jiti": "2.7.0",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
