{
  "name": "@cbnventures/nova",
  "version": "0.52.0",
  "description": "Strict presets, guided tooling, and project scaffolds for JavaScript and TypeScript developers",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "typescript",
    "tsconfig",
    "tsconfig-presets",
    "linting",
    "code-style",
    "scripts",
    "templates",
    "docusaurus-preset",
    "react",
    "nextjs",
    "node",
    "monorepo"
  ],
  "license": "MIT",
  "homepage": "https://nova.cbnventures.io/",
  "bugs": {
    "email": "bugs@cbnventures.io",
    "url": "https://github.com/cbnventures/nova/issues"
  },
  "author": {
    "name": "CBN Ventures",
    "email": "contact@cbnventures.io",
    "url": "https://www.cbnventures.io/"
  },
  "contributors": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/"
    }
  ],
  "funding": [
    "https://github.com/sponsors/cbnventures",
    "https://www.paypal.com/biz/profile/cbnventures"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbnventures/nova.git",
    "directory": "packages/nova"
  },
  "exports": {
    "./rules/eslint": "./build/rules/eslint/index.js",
    "./rules/eslint/*": "./build/rules/eslint/*.js",
    "./rules/vitest": "./build/rules/vitest/index.js",
    "./rules/vitest/*": "./build/rules/vitest/*.js",
    "./presets/eslint": "./build/presets/eslint/index.js",
    "./presets/eslint/*": "./build/presets/eslint/*.js",
    "./presets/tsconfig/dx-essentials.json": "./build/presets/tsconfig/dx-essentials.json",
    "./presets/tsconfig/dx-strict.json": "./build/presets/tsconfig/dx-strict.json",
    "./presets/tsconfig/fw-astro.json": "./build/presets/tsconfig/fw-astro.json",
    "./presets/tsconfig/fw-docusaurus.json": "./build/presets/tsconfig/fw-docusaurus.json",
    "./presets/tsconfig/fw-expressjs.json": "./build/presets/tsconfig/fw-expressjs.json",
    "./presets/tsconfig/fw-homebridge.json": "./build/presets/tsconfig/fw-homebridge.json",
    "./presets/tsconfig/fw-nextjs.json": "./build/presets/tsconfig/fw-nextjs.json",
    "./presets/tsconfig/fw-react.json": "./build/presets/tsconfig/fw-react.json",
    "./presets/tsconfig/fw-svelte.json": "./build/presets/tsconfig/fw-svelte.json",
    "./presets/tsconfig/fw-vue.json": "./build/presets/tsconfig/fw-vue.json",
    "./presets/tsconfig/runtime-browser.json": "./build/presets/tsconfig/runtime-browser.json",
    "./presets/tsconfig/runtime-cloudflare-workers.json": "./build/presets/tsconfig/runtime-cloudflare-workers.json",
    "./presets/tsconfig/runtime-edge.json": "./build/presets/tsconfig/runtime-edge.json",
    "./presets/tsconfig/runtime-node.json": "./build/presets/tsconfig/runtime-node.json",
    "./presets/tsconfig/runtime-service-worker.json": "./build/presets/tsconfig/runtime-service-worker.json",
    "./presets/tsconfig/runtime-web-worker.json": "./build/presets/tsconfig/runtime-web-worker.json",
    "./presets/tsconfig/role-app.json": "./build/presets/tsconfig/role-app.json",
    "./presets/tsconfig/role-config.json": "./build/presets/tsconfig/role-config.json",
    "./presets/tsconfig/role-scripts.json": "./build/presets/tsconfig/role-scripts.json",
    "./presets/tsconfig/role-source.json": "./build/presets/tsconfig/role-source.json",
    "./presets/tsconfig/role-tests.json": "./build/presets/tsconfig/role-tests.json",
    "./presets/tsconfig/tool-vite.json": "./build/presets/tsconfig/tool-vite.json",
    "./toolkit": "./build/toolkit/index.js",
    "./toolkit/*": "./build/toolkit/*.js",
    "./types/*": "./build/types/*"
  },
  "type": "module",
  "files": [
    "./bin",
    "./build",
    "./scaffold-versions.json"
  ],
  "bin": {
    "nova": "bin/nova.mjs"
  },
  "private": false,
  "scripts": {
    "dev": "node ../../scripts/nova-run-scripts.mjs --parallel --node-env development \"dev:*\"",
    "dev:watch": "node ../../scripts/nova-transpile.mjs --project tsconfig.source.json --watch",
    "check": "node ../../scripts/nova-run-scripts.mjs --sequential \"check:*\"",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-source": "node ../../scripts/nova-type-check.mjs --project tsconfig.source.json",
    "check:types-config": "node ../../scripts/nova-type-check.mjs --project tsconfig.config.json",
    "check:types-tests": "node ../../scripts/nova-type-check.mjs --project tsconfig.tests.json",
    "check:coverage": "vitest run --coverage",
    "build": "node ../../scripts/nova-run-scripts.mjs --sequential --node-env production \"build:*\"",
    "build:reset": "shx rm -rf ./build",
    "build:transpile-source": "node ../../scripts/nova-transpile.mjs --project tsconfig.source.json",
    "build:copy-types": "shx rm -rf \"./build/types\" && shx cp -r \"./src/types\" \"./build/types\"",
    "build:copy-tsconfig-presets": "shx rm -rf \"./build/presets/tsconfig\" && shx cp -r \"./src/presets/tsconfig\" \"./build/presets/tsconfig\"",
    "build:fix-perms": "shx chmod +x ./build/cli/index.js",
    "build:copy-templates": "shx rm -rf \"./build/templates\" && shx cp -r \"./templates\" \"./build/templates\"",
    "clean": "node ../../scripts/nova-run-scripts.mjs --parallel \"clean:*\"",
    "clean:build": "shx rm -rf ./build"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@eslint/js": "9.39.3",
    "@next/eslint-plugin-next": "16.3.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.58.1",
    "@typescript-eslint/utils": "8.58.1",
    "astro-eslint-parser": "1.4.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "corepack": "0.36.0",
    "cross-env": "10.1.0",
    "eslint-mdx": "3.8.1",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.1",
    "glob": "13.0.6",
    "globals": "17.13.0",
    "google-auth-library": "11.3.1",
    "minimatch": "10.2.6",
    "prompts": "2.4.2",
    "svelte": "5.57.2",
    "typescript-eslint": "8.58.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "14.0.0",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.9.1",
    "@types/prompts": "2.4.9",
    "@typescript-eslint/rule-tester": "8.58.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "eslint": "^9",
    "typescript": "^6",
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
