{
  "name": "nova-project",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "prod": "turbo run prod",
    "build": "turbo run build --concurrency=2",
    "check": "turbo run check --concurrency=2 && eslint . --max-warnings=0 && node ./scripts/nova-type-check.mjs --project tsconfig.config.json && node ./scripts/nova-type-check.mjs --project tsconfig.scripts.json && node ./scripts/nova-type-check.mjs --project tsconfig.tests.json && vitest run",
    "check:scaffolds": "node ./scripts/check-scaffolds.mjs",
    "deploy": "turbo run deploy --concurrency=2",
    "clean": "turbo run clean",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "allowScripts": {
    "core-js": false,
    "es5-ext": false,
    "unrs-resolver": false
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "devDependencies": {
    "@cbnventures/nova": "file:./packages/nova",
    "@inquirer/prompts": "8.4.3",
    "chalk": "5.6.2",
    "chokidar": "3.6.0",
    "jiti": "2.7.0",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
