{
  "name": "nova-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/nova-run-scripts.mjs --parallel 'dev:*'",
    "dev:start": "PORTLESS_PORT=3000 portless dev-nova-docs docusaurus start --host 0.0.0.0 --no-open",
    "prod": "node ../../scripts/nova-run-scripts.mjs --sequential 'prod:*'",
    "prod:serve": "PORTLESS_PORT=3000 portless prod-nova-docs docusaurus serve --host 0.0.0.0 --no-open",
    "check": "node ../../scripts/nova-run-scripts.mjs --sequential 'check:*'",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-app": "nova utility type-check --project tsconfig.app.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "node ../../scripts/nova-run-scripts.mjs --sequential 'build:*'",
    "build:build": "docusaurus build",
    "build:transpile-app": "nova utility transpile --project tsconfig.app.json",
    "clean": "node ../../scripts/nova-run-scripts.mjs --parallel 'clean:*'",
    "clean:build": "shx rm -rf ./build",
    "clean:clear": "docusaurus clear",
    "i18n": "nova utility run-scripts --sequential 'i18n:*'",
    "i18n:sync": "theme-nova i18n sync",
    "i18n:check": "theme-nova i18n check",
    "i18n:coverage": "theme-nova i18n coverage"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@cbnventures/docusaurus-preset-nova": "file:../../packages/docusaurus-preset-nova",
    "@cbnventures/nova": "file:../../packages/nova",
    "@docusaurus/core": "3.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "24.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "portless": "0.15.5",
    "eslint": "9.39.5",
    "glob": "13.0.6",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
