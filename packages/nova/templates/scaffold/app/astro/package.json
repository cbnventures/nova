{
  "name": "[__WORKSPACE_PACKAGE_NAME__]",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development 'dev:*'",
    "dev:start": "astro dev",
    "prod": "nova utility run-scripts --sequential --node-env production 'prod:*'",
    "prod:preview": "astro preview",
    "check": "nova utility run-scripts --sequential 'check:*'",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:astro": "astro check --tsconfig tsconfig.astro.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential --node-env production 'build:*'",
    "build:site": "astro build",
    "clean": "nova utility run-scripts --parallel 'clean:*'",
    "clean:build": "shx rm -rf ./build"
  },
  "engines": {
    "node": "[__SCAFFOLD_VERSION_NODE_ENGINE__]"
  },
  "dependencies": {
    "@cbnventures/nova": "0.32.0",
    "astro": "[__SCAFFOLD_VERSION_ASTRO__]",
    "cookie": "[__SCAFFOLD_VERSION_COOKIE__]"
  },
  "devDependencies": {
    "@astrojs/check": "[__SCAFFOLD_VERSION_ASTRO_CHECK__]",
    "@types/node": "[__SCAFFOLD_VERSION_TYPES_NODE_24__]",
    "eslint": "[__SCAFFOLD_VERSION_ESLINT__]",
    "shx": "[__SCAFFOLD_VERSION_SHX__]",
    "typescript": "[__SCAFFOLD_VERSION_TYPESCRIPT__]",
    "vitest": "[__SCAFFOLD_VERSION_VITEST__]"
  }
}
