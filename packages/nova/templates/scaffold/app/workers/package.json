{
  "name": "[__WORKSPACE_PACKAGE_NAME__]",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nova utility run-scripts --parallel 'dev:*'",
    "dev:worker": "wrangler dev",
    "check": "nova utility run-scripts --sequential 'check:*'",
    "check:types": "nova utility type-check --project tsconfig.json",
    "build": "nova utility run-scripts --sequential 'build:*'",
    "build:types": "tsc",
    "deploy": "nova utility run-scripts --sequential 'deploy:*'",
    "deploy:worker": "wrangler deploy",
    "clean": "nova utility run-scripts --parallel 'clean:*'",
    "clean:wrangler": "shx rm -rf ./.wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "wrangler": "4.131.1"
  }
}
