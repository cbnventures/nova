{
  "project": {
    "name": {
      "title": "Nova",
      "slug": "nova"
    },
    "description": {
      "short": "Scripts, templates, and project configuration for the common JavaScript and TypeScript developer",
      "long": "Nova is a JavaScript and TypeScript monorepo suite, offering strict presets and guided tooling to help you build with confidence, predictability, and minimal setup. It delivers strong defaults, robust linting and typing, and scaffolded project generators — all wrapped in guardrails that keep your workflow safe without sacrificing flexibility."
    },
    "keywords": [
      "eslint",
      "eslint-config",
      "eslint-flat-config",
      "typescript",
      "tsconfig",
      "tsconfig-presets",
      "linting",
      "code-style",
      "scripts",
      "templates",
      "docusaurus-preset",
      "react",
      "nextjs",
      "node",
      "monorepo"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs"
    ],
    "startingYear": 2025,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "nova",
    "topics": [
      "eslint-config",
      "eslint",
      "typescript",
      "tsconfig",
      "eslint-flat-config",
      "monorepo",
      "linting",
      "developer-tools"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "autoDeleteHeadBranch": true
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ]
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ]
    },
    {
      "template": "publish",
      "name": "sites",
      "triggers": [
        "tag-push"
      ],
      "build": [
        "./packages/nova",
        "./packages/docusaurus-preset-nova",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "npm",
          "path": "./packages/nova"
        },
        {
          "to": "npm",
          "path": "./packages/docusaurus-preset-nova",
          "after": [
            "./packages/nova"
          ]
        },
        {
          "to": "github-packages",
          "path": "./packages/nova"
        },
        {
          "to": "github-packages",
          "path": "./packages/docusaurus-preset-nova",
          "after": [
            "./packages/nova"
          ]
        },
        {
          "to": "cloudflare-pages-docusaurus",
          "path": "./apps/docs"
        }
      ]
    }
  ],
  "environment": {
    "global": {
      "prefix": "PROJECT_"
    },
    "apps": {
      "./apps/docs": {
        "prefix": "DOCS_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGI_"
      }
    }
  },
  "urls": {
    "homepage": "https://nova.cbnventures.io/",
    "repository": "git+https://github.com/cbnventures/nova.git",
    "bugs": "https://github.com/cbnventures/nova/issues",
    "license": "https://github.com/cbnventures/nova/blob/HEAD/LICENSE",
    "logo": "https://nova.cbnventures.io/images/logo.svg",
    "documentation": "https://nova.cbnventures.io/",
    "npm": "https://www.npmjs.com/package/@cbnventures/nova",
    "fundSources": [
      "https://github.com/sponsors/cbnventures",
      "https://www.paypal.com/biz/profile/cbnventures"
    ],
    "privacyPolicy": "https://www.cbnventures.io/privacy/",
    "termsOfUse": "https://www.cbnventures.io/terms/"
  },
  "workspaces": {
    "./": {
      "role": "project",
      "policy": "freezable",
      "name": "nova-project"
    },
    "./apps/demo-envoy": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-envoy"
    },
    "./apps/demo-foundry": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-foundry"
    },
    "./apps/demo-lantern": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-lantern"
    },
    "./apps/demo-marshal": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-marshal"
    },
    "./apps/demo-sentinel": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-sentinel"
    },
    "./apps/demo-signal": {
      "role": "template",
      "policy": "freezable",
      "name": "demo-signal"
    },
    "./apps/docs": {
      "role": "docs",
      "policy": "freezable",
      "name": "nova-docs"
    },
    "./packages/docusaurus-preset-nova": {
      "role": "package",
      "policy": "distributable",
      "name": "@cbnventures/docusaurus-preset-nova"
    },
    "./packages/nova": {
      "role": "package",
      "policy": "distributable",
      "name": "@cbnventures/nova"
    }
  },
  "gitignore": {
    "projectExcludes": [
      "!packages/nova/bin/",
      "graphify-out/"
    ]
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
