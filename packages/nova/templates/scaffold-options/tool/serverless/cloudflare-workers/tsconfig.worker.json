{
  "extends": [
    "@cbnventures/nova/presets/tsconfig/dx-essentials.json",
    "@cbnventures/nova/presets/tsconfig/dx-strict.json",
    "@cbnventures/nova/presets/tsconfig/role-source.json",
    "@cbnventures/nova/presets/tsconfig/runtime-cloudflare-workers.json"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmitOnError": false,
    "outDir": "./build"
  },
  "include": [
    "./src/worker/**/*.ts",
    "./src/types/worker/**/*.d.ts"
  ],
  "exclude": [
    "./src/**/*.test.ts"
  ]
}
