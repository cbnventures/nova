{
  "name": "[__WORKSPACE_PACKAGE_NAME__]",
  "version": "[__WORKSPACE_VERSION__]",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "supports-hap"
  ],
  "main": "./build/index.js",
  "type": "module",
  "files": [
    "bin",
    "build",
    "config.schema.json"
  ],
  "bin": {
    "[__WORKSPACE_PACKAGE_NAME__]-repl": "./bin/repl.mjs",
    "[__WORKSPACE_PACKAGE_NAME__]-test-api": "./bin/test-api.mjs"
  },
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development \"dev:*\"",
    "dev:watch": "nova utility transpile --project tsconfig.source.json --watch",
    "prod": "nova utility run-scripts --sequential --node-env production \"prod:*\"",
    "prod:homebridge": "npm run build && homebridge --debug --keep-orphans --plugin-path $(pwd)",
    "check": "nova utility run-scripts --sequential \"check:*\"",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-source": "nova utility type-check --project tsconfig.source.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential --node-env production \"build:*\"",
    "build:reset": "shx rm -rf ./build",
    "build:transpile": "nova utility transpile --project tsconfig.source.json",
    "build:permissions": "shx chmod +x ./bin/repl.mjs ./bin/test-api.mjs ./build/cli/repl.js ./build/cli/test-api.js",
    "clean": "nova utility run-scripts --parallel \"clean:*\"",
    "clean:build": "shx rm -rf ./build",
    "repl": "node ./build/cli/repl.js",
    "test-api": "node ./build/cli/test-api.js"
  },
  "engines": {
    "homebridge": "[__SCAFFOLD_VERSION_HOMEBRIDGE_PEER__]",
    "node": "[__SCAFFOLD_VERSION_NODE_ENGINE__]"
  },
  "dependencies": {
    "@cbnventures/nova": "0.34.1"
  },
  "devDependencies": {
    "@types/node": "[__SCAFFOLD_VERSION_TYPES_NODE_24__]",
    "eslint": "[__SCAFFOLD_VERSION_ESLINT__]",
    "homebridge": "[__SCAFFOLD_VERSION_HOMEBRIDGE__]",
    "shx": "[__SCAFFOLD_VERSION_SHX__]",
    "typescript": "[__SCAFFOLD_VERSION_TYPESCRIPT__]",
    "vitest": "[__SCAFFOLD_VERSION_VITEST__]"
  }
}
